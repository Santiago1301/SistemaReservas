# Copia este archivo como .env y completa los valores (panel de Supabase).

# Dirección de la API del proyecto: https://<ref>.supabase.co
SUPABASE_URL=

# Clave pública (sb_publishable_...): respeta las reglas de permisos de cada tabla
SUPABASE_PUBLISHABLE_KEY=

# Clave privilegiada (sb_secret_...): solo backend, se salta las reglas de permisos
SUPABASE_SECRET_KEY=

# Conexión directa a PostgreSQL (Connect > Session pooler): postgresql://...
SUPABASE_DB_URL=
